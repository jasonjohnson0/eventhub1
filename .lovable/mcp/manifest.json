{
  "version": 1,
  "sdk_version": "2.0.4",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://fopxmuaogwchohwhrclk.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "eventhub",
      "version": "0.1.0",
      "title": "EventHub"
    },
    "tools": [
      {
        "name": "list_events",
        "title": "List events",
        "description": "List events visible to the signed-in user, optionally filtered by category, status, text search and date range.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Match against event title."
            },
            "category": {
              "type": "string",
              "enum": [
                "sports",
                "networking",
                "education",
                "social",
                "fundraiser",
                "workshop",
                "other"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "rejected",
                "removed"
              ]
            },
            "from": {
              "type": "string",
              "description": "ISO date/time lower bound on start_time."
            },
            "to": {
              "type": "string",
              "description": "ISO date/time upper bound on start_time."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_event",
        "title": "Get event",
        "description": "Fetch the full details of a single event by its id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "Event id."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_event",
        "title": "Create event",
        "description": "Create a new event owned by the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": {
              "type": "string",
              "maxLength": 4000
            },
            "location": {
              "type": "string",
              "maxLength": 300
            },
            "start_time": {
              "type": "string",
              "description": "ISO 8601 start time, e.g. 2026-10-01T18:00:00Z."
            },
            "end_time": {
              "type": "string",
              "description": "ISO 8601 end time."
            },
            "category": {
              "type": "string",
              "enum": [
                "sports",
                "networking",
                "education",
                "social",
                "fundraiser",
                "workshop",
                "other"
              ],
              "default": "other"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "maxItems": 20,
              "default": []
            },
            "event_format": {
              "type": "string",
              "enum": [
                "in_person",
                "virtual",
                "hybrid"
              ],
              "default": "in_person"
            },
            "virtual_link": {
              "type": "string",
              "format": "uri",
              "maxLength": 500
            }
          },
          "required": [
            "title",
            "start_time",
            "end_time"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_event",
        "title": "Update event",
        "description": "Update fields on an existing event the signed-in user is allowed to manage. Only provided fields change.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": {
              "type": "string",
              "maxLength": 4000
            },
            "location": {
              "type": "string",
              "maxLength": 300
            },
            "start_time": {
              "type": "string",
              "description": "ISO 8601 start time."
            },
            "end_time": {
              "type": "string",
              "description": "ISO 8601 end time."
            },
            "category": {
              "type": "string",
              "enum": [
                "sports",
                "networking",
                "education",
                "social",
                "fundraiser",
                "workshop",
                "other"
              ]
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "maxItems": 20
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "rejected"
              ]
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_venues",
        "title": "List venues",
        "description": "List venues available to the signed-in user, for use when scheduling events.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "Match against venue name."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
